<!--OpenUtau Chiaki overlay for zh-TW. Merged after the Lunai overlays in App.SetLanguage.-->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:system="clr-namespace:System;assembly=mscorlib"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <system:String x:Key="dawintegration.bpmmismatch">DAW 專案的節奏與本專案不一致。兩條時間軸只能以秒對齊，無法以小節對齊——請將兩邊節奏調成一致。</system:String>
  <system:String x:Key="dawintegration.caption">DAW 整合</system:String>
  <system:String x:Key="dawintegration.col.apiversion">API</system:String>
  <system:String x:Key="dawintegration.col.compatibility">狀態</system:String>
  <system:String x:Key="dawintegration.col.name">外掛程式</system:String>
  <system:String x:Key="dawintegration.col.port">連接埠</system:String>
  <system:String x:Key="dawintegration.col.state">連線</system:String>
  <system:String x:Key="dawintegration.compatible">相容</system:String>
  <system:String x:Key="dawintegration.connect">連線</system:String>
  <system:String x:Key="dawintegration.connected">已連線到 {0}。</system:String>
  <system:String x:Key="dawintegration.connected.count">已連線 {0} 個外掛程式。</system:String>
  <system:String x:Key="dawintegration.connecting">正在連線...</system:String>
  <system:String x:Key="dawintegration.disconnect">中斷連線</system:String>
  <system:String x:Key="dawintegration.disconnected">未連線。</system:String>
  <system:String x:Key="dawintegration.guide.caps.1">自動跟隨每一次編輯——專案與每個算繪完成的段落都會即時傳送給外掛程式。</system:String>
  <system:String x:Key="dawintegration.guide.caps.2">每條 DAW 音軌放一個外掛程式實例，可在外掛程式視窗或 DAW 的自動化面板中選擇該實例播放哪條 OpenUtau 音軌。</system:String>
  <system:String x:Key="dawintegration.guide.caps.3">播放頭同步——OpenUtau 的播放頭會跟隨 DAW 的走帶控制。</system:String>
  <system:String x:Key="dawintegration.guide.caps.4">方便匯出——DAW 輸出（bounce）時會等待仍在算繪的段落，匯出結果與播放一致。</system:String>
  <system:String x:Key="dawintegration.guide.caps.header">功能</system:String>
  <system:String x:Key="dawintegration.guide.caption">使用說明</system:String>
  <system:String x:Key="dawintegration.guide.download">下載 {0} 版</system:String>
  <system:String x:Key="dawintegration.guide.install.clap">安裝 CLAP</system:String>
  <system:String x:Key="dawintegration.guide.install.clap.reinstall">重新安裝 CLAP</system:String>
  <system:String x:Key="dawintegration.guide.install.done">已安裝到 {0}。請在 DAW 中重新掃描外掛程式，再回到這裡按「重新整理」。</system:String>
  <system:String x:Key="dawintegration.guide.install.downloading">正在下載... {0}%</system:String>
  <system:String x:Key="dawintegration.guide.install.elevfail">以系統管理員權限複製失敗（{0}），已改為安裝到使用者資料夾 {1}。請在 DAW 中重新掃描外掛程式，再回到這裡按「重新整理」。</system:String>
  <system:String x:Key="dawintegration.guide.install.extracting">正在解壓縮...</system:String>
  <system:String x:Key="dawintegration.guide.install.failed">安裝失敗：{0}</system:String>
  <system:String x:Key="dawintegration.guide.install.fallback">未取得系統管理員授權，已改為安裝到使用者資料夾 {1}。請在 DAW 中重新掃描外掛程式，再回到這裡按「重新整理」。</system:String>
  <system:String x:Key="dawintegration.guide.install.header">安裝外掛程式（已自動偵測本機狀態）</system:String>
  <system:String x:Key="dawintegration.guide.install.preparing">正在準備下載...</system:String>
  <system:String x:Key="dawintegration.guide.install.vst3">安裝 VST3</system:String>
  <system:String x:Key="dawintegration.guide.install.vst3.reinstall">重新安裝 VST3</system:String>
  <system:String x:Key="dawintegration.guide.installed.no">未安裝</system:String>
  <system:String x:Key="dawintegration.guide.installed.ok">已安裝</system:String>
  <system:String x:Key="dawintegration.guide.manual">完整手冊</system:String>
  <system:String x:Key="dawintegration.guide.manual.zh">使用手冊（簡體中文）</system:String>
  <system:String x:Key="dawintegration.guide.paths.linux">VST3：~/.vst3&#10;CLAP：~/.clap</system:String>
  <system:String x:Key="dawintegration.guide.paths.mac">VST3：~/Library/Audio/Plug-Ins/VST3&#10;CLAP：~/Library/Audio/Plug-Ins/CLAP</system:String>
  <system:String x:Key="dawintegration.guide.paths.win">VST3：C:\Program Files\Common Files\VST3&#10;CLAP：C:\Program Files\Common Files\CLAP&#10;沒有系統管理員權限？請改用 %LOCALAPPDATA%\Programs\Common\VST3（或 ...\CLAP）。</system:String>
  <system:String x:Key="dawintegration.guide.releases">所有版本</system:String>
  <system:String x:Key="dawintegration.guide.scope.1">橋接僅限同一台電腦，且 DAW 需能載入 VST3 或 CLAP 樂器（REAPER、Cubase、FL Studio、Studio One、Ableton Live、Bitwig 等）。</system:String>
  <system:String x:Key="dawintegration.guide.scope.2">兩條時間軸以絕對時間對齊——兩邊專案使用相同 BPM，小節才會對齊。</system:String>
  <system:String x:Key="dawintegration.guide.scope.3">OpenUtau 只負責歌聲：音量、聲像、靜音與效果都在 DAW 混音台處理。</system:String>
  <system:String x:Key="dawintegration.guide.scope.header">限制</system:String>
  <system:String x:Key="dawintegration.guide.step1">1. 安裝外掛程式：按上方的安裝按鈕（若跳出系統管理員授權請確認），或手動下載後將整個 &quot;OpenUtau Bridge.vst3&quot; 資料夾複製到 DAW 的外掛程式資料夾：</system:String>
  <system:String x:Key="dawintegration.guide.step2">2. 在 DAW 中新增一條樂器音軌並插入 &quot;OpenUtau Bridge&quot;（廠商 OpenUTAU）。請在 OpenUtau 尚未開啟時進行——DAW 要先開。</system:String>
  <system:String x:Key="dawintegration.guide.step3">3. 開啟 OpenUtau 並儲存專案，再回到這裡：重新整理 → 選取外掛程式 → 連線。</system:String>
  <system:String x:Key="dawintegration.guide.steps.header">設定（三個步驟）</system:String>
  <system:String x:Key="dawintegration.guide.what">OpenUtau Bridge 是一個免費的 DAW 外掛程式（VST3/CLAP），會接收 OpenUtau 的專案與算繪好的音訊，並放到 DAW 的時間軸上：在 OpenUtau 中寫歌與調音，在 DAW 中混音。它本身不會發聲，OpenUtau 這邊也不需要額外設定。</system:String>
  <system:String x:Key="dawintegration.hint">連線到本機上正在等待連線的 DAW 外掛程式。編輯仍在 OpenUtau 中進行；外掛程式會接收專案與算繪好的音訊。</system:String>
  <system:String x:Key="dawintegration.incompatible">不支援的 API 版本</system:String>
  <system:String x:Key="dawintegration.lost">連線中斷：{0}</system:String>
  <system:String x:Key="dawintegration.none">找不到 DAW 外掛程式。請先在 DAW 的樂器音軌上載入 OpenUtau Bridge 外掛程式，再按「重新整理」。第一次使用？請展開上方的「使用說明」。</system:String>
  <system:String x:Key="dawintegration.none.installed">外掛程式已安裝，但找不到執行中的實例。請在 DAW 的樂器音軌上載入 OpenUtau Bridge，再按「重新整理」。</system:String>
  <system:String x:Key="dawintegration.reconnecting">正在重新連線到 {0}...</system:String>
  <system:String x:Key="dawintegration.refresh">重新整理</system:String>
  <system:String x:Key="dawintegration.state.connected">已連線</system:String>
  <system:String x:Key="dawintegration.state.connecting">連線中</system:String>
  <system:String x:Key="dawintegration.state.free">未連線</system:String>
  <system:String x:Key="dawintegration.state.reconnecting">重新連線中</system:String>
  <system:String x:Key="dawintegration.unsavedproject">專案尚未儲存。請先儲存專案，再連線 DAW 外掛程式——未儲存的專案無法傳送到 DAW。</system:String>
  <system:String x:Key="dialogs.about.contributors.intro">以下人員為 GitHub 上原始 OpenUtau 存放庫做出了貢獻。OpenUtau Lunai 與本版本都建立在他們的成果之上。感謝所有列出的貢獻者！</system:String>
  <system:String x:Key="dialogs.about.license">本版本所基於的 OpenUtau 與 OpenUtau Lunai 皆為採用 MIT 授權的免費開源軟體。</system:String>
  <system:String x:Key="dialogs.about.lunai.message">您正在執行 OpenUtau Chiaki，這是 OpenUtau Lunai 的個人版本，內建 Chiaki DiffSinger 聲庫與 DiffSinger 芬蘭文音素器。OpenUtau Lunai 是一個旨在讓 DiffSinger 更易用、更愉快的分支。</system:String>
  <system:String x:Key="dialogs.reportissue.message">請在 GitHub issues 回報問題，有幫助時請附上記錄檔。</system:String>
  <system:String x:Key="dialogs.reportissue.github.description">描述發生了什麼問題以及重現步驟。如有需要，請從「說明 → 開啟記錄檔位置」附加記錄檔。</system:String>
  <system:String x:Key="dialogs.reportissue.github.open">開啟 issues</system:String>
  <system:String x:Key="dialogs.reportissue.github.title">GitHub Issues</system:String>
  <system:String x:Key="menu.tools.dawintegration">DAW 整合...</system:String>
  <system:String x:Key="pianoroll.toggle.hidepianoroll">隱藏鋼琴卷軸</system:String>
</ResourceDictionary>
