<!--OpenUtau Chiaki overlay for ru-RU. Merged after the Lunai overlays in App.SetLanguage.-->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:system="clr-namespace:System;assembly=mscorlib"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <system:String x:Key="errors.unhandled.fatal">Произошла критическая ошибка, OpenUtau Chiaki будет закрыт. Подробности записаны в лог.</system:String>
</ResourceDictionary>
